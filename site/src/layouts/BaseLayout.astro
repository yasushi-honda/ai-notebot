---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '毎日のAIトレンドを出典付きでアーカイブするブログ' } = Astro.props;
const siteTitle = 'ai-notebot';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  </head>
  <body>
    <header class="border-b border-rule bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-6 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
        <a href={url('')} class="no-underline shrink-0">
          <span class="font-mono font-extrabold text-[22px] tracking-tight text-ink whitespace-nowrap">
            ai<span class="text-verify">-</span>notebot
          </span>
        </a>
        <nav class="flex gap-5 text-[13px] font-medium text-ink-soft whitespace-nowrap">
          <a href={url('archive/')} class="hover:text-verify">アーカイブ</a>
          <a href={url('care/')} class="hover:text-care">介護AIハック</a>
          <a href={url('about/')} class="hover:text-verify">About</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
    <footer class="border-t border-rule mt-16">
      <div class="mx-auto max-w-3xl px-6 py-6 text-xs text-ink-soft">
        毎日 AI 関連のニュース・ハック・話題を収集し、出典を脚注で紐付けて自動生成しています。
      </div>
    </footer>
  </body>
</html>
