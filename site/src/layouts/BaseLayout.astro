---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '毎日のAIトレンドを出典付きでアーカイブするブログ' } = Astro.props;
const siteTitle = 'ai-notebot';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  </head>
  <body>
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto max-w-3xl px-4 py-5 flex items-center justify-between">
        <a href={url('')} class="no-underline">
          <span class="text-2xl font-bold text-stone-900 tracking-tight" style="font-family: var(--font-logo);">
            ai<span class="text-indigo-500">-</span>notebot
          </span>
        </a>
        <nav class="flex gap-4 text-sm text-stone-600">
          <a href={url('archive/')} class="hover:text-indigo-600">アーカイブ</a>
          <a href={url('care/')} class="hover:text-teal-600">介護AIハック</a>
          <a href={url('about/')} class="hover:text-indigo-600">About</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 py-8 border-t border-stone-200 mt-12 text-xs text-stone-400">
      毎日 AI 関連のニュース・ハック・話題を収集し、出典を脚注で紐付けて自動生成しています。
    </footer>
  </body>
</html>
