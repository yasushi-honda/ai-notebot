---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latest = allPosts[0];
const rest = allPosts.slice(1, 6);

const carePosts = (await getCollection('care')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestCare = carePosts[0];

// themes（{title, sourceCount}）はこのフィールド追加より前の記事には存在しない
// （スキーマのdefault []になる）。その場合は themeTitles（件数なし）にフォールバックする
// （posts/[date]/index.astro の shareText 同様のフォールバックパターン）。
const todayThemes = latest
  ? latest.data.themes.length > 0
    ? latest.data.themes
    : latest.data.themeTitles.map((title) => ({ title, sourceCount: null as number | null }))
  : [];
---

<BaseLayout title="毎日のAIトレンドまとめ">
  {latest && (
    <section class="pb-10 border-b-[3px] border-double border-rule-strong">
      <p class="verify-label mb-4.5">
        <span class="verify-dot"></span>
        本日の記録・出典{latest.data.sourceIds.length}件を機械検証済み
      </p>
      <div class="font-mono text-[13px] text-ink-soft tabular-nums">{latest.data.date}</div>
      <h1 class="font-display text-[34px] font-medium leading-[1.45] mt-1.5 mb-4.5">
        <a
          href={url(`posts/${latest.data.date}/`)}
          class="text-ink underline decoration-rule-strong decoration-1 underline-offset-[5px]
            transition-colors hover:text-verify hover:decoration-current"
        >
          {latest.data.title}
        </a>
      </h1>

      <a href={url(`posts/${latest.data.date}/`)} class="block mb-6">
        <img
          src={url(`images/${latest.data.date}/hero.jpg`)}
          alt={latest.data.title}
          class="w-full aspect-[21/9] object-cover rounded-lg border border-rule"
          onerror="this.onerror=null;this.src=this.src.replace('.jpg','.svg')"
        />
      </a>

      {todayThemes.length > 0 && (
        <div class="today-toc">
          {todayThemes.map((theme) => (
            <div class="today-toc-item">
              {theme.sourceCount !== null && <span class="toc-count">{theme.sourceCount}件</span>}
              <span class="toc-title">{theme.title}</span>
            </div>
          ))}
        </div>
      )}
    </section>
  )}

  <div class="h-8"></div>

  {latestCare && (
    <a href={url(`care/${latestCare.data.date}/`)} class="care-callout block no-underline mb-9">
      <div class="kicker">介護AIハック・{latestCare.data.date}</div>
      <h3>{latestCare.data.title}</h3>
      <p>{latestCare.data.summary}</p>
    </a>
  )}

  {rest.length > 0 && (
    <section>
      <div class="ledger-heading">過去の記録</div>
      {rest.map((post) => (
        <div class="entry">
          <a href={url(`posts/${post.data.date}/`)} class="block">
            <div class="entry-date tabular-nums">{post.data.date}</div>
            <img
              src={url(`images/${post.data.date}/hero.jpg`)}
              alt=""
              class="entry-thumb"
              onerror="this.style.display='none'"
            />
          </a>
          <div class="entry-body">
            <h3><a href={url(`posts/${post.data.date}/`)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
        </div>
      ))}
    </section>
  )}

  <div class="mt-8">
    <a href={url('archive/')} class="text-sm font-medium text-verify underline decoration-verify-soft decoration-1 underline-offset-2 hover:decoration-current">
      すべてのアーカイブを見る
    </a>
  </div>
</BaseLayout>
