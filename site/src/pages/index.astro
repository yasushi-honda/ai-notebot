---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latest = allPosts[0];
const rest = allPosts.slice(1, 8);

const carePosts = (await getCollection('care')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestCare = carePosts[0];

function heroSrc(date: string) {
  return url(`images/${date}/hero.jpg`);
}
---

<BaseLayout title="毎日のAIトレンドまとめ">
  <p class="text-stone-600 mb-10 text-[15px] leading-relaxed max-w-lg">
    毎日 AI 関連のニュース・ハック・話題を収集し、出典を脚注で紐付けた日本語ブログとして自動生成しています。
  </p>

  {latest && (
    <a
      href={url(`posts/${latest.data.date}/`)}
      class="block mb-10 rounded-xl overflow-hidden border border-stone-200 bg-white no-underline"
    >
      <img
        src={heroSrc(latest.data.date)}
        alt={latest.data.title}
        class="w-full aspect-video object-cover"
        onerror="this.onerror=null;this.src=this.src.replace('.jpg','.svg')"
      />
      <div class="p-6">
        <div class="text-xs text-indigo-600 font-semibold mb-2 tabular-nums">最新記事 · {latest.data.date}</div>
        <h2 class="text-2xl font-bold text-stone-900 mb-2" style="font-family: var(--font-display);">{latest.data.title}</h2>
        <p class="text-sm text-stone-600">{latest.data.description}</p>
      </div>
    </a>
  )}

  {latestCare && (
    <a
      href={url(`care/${latestCare.data.date}/`)}
      class="block mb-12 rounded-xl border border-stone-200 bg-white no-underline p-6"
    >
      <div class="text-xs text-teal-600 font-semibold mb-2 tabular-nums">介護AIハック · {latestCare.data.date}</div>
      <h2 class="text-2xl font-bold text-stone-900 mb-2" style="font-family: var(--font-display);">{latestCare.data.title}</h2>
      <p class="text-sm text-stone-600">{latestCare.data.summary}</p>
    </a>
  )}

  {rest.length > 0 && (
    <section>
      <h3 class="text-sm font-semibold text-stone-500 mb-1">最近の記事</h3>
      <ul>
        {rest.map((post) => (
          <li>
            <a href={url(`posts/${post.data.date}/`)} class="list-link">
              <div class="text-xs text-stone-400 mb-1 tabular-nums">{post.data.date}</div>
              <div class="list-link-title">{post.data.title}</div>
              <div class="text-sm text-stone-500 mt-1">{post.data.description}</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-8">
    <a href={url('archive/')} class="text-sm text-indigo-600 hover:underline">
      すべてのアーカイブを見る →
    </a>
  </div>
</BaseLayout>
