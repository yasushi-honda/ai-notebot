---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latest = allPosts[0];
const rest = allPosts.slice(1, 8);

function heroSrc(date: string) {
  return url(`images/${date}/hero.jpg`);
}
---

<BaseLayout title="毎日のAIトレンドまとめ">
  <p class="text-slate-600 mb-8">
    毎日 AI 関連のニュース・ハック・話題を収集し、出典を脚注で紐付けた日本語ブログとして自動生成しています。
  </p>

  {latest && (
    <a
      href={url(`posts/${latest.data.date}/`)}
      class="block mb-10 rounded-xl overflow-hidden border border-slate-200 bg-white hover:shadow-lg transition-shadow no-underline"
    >
      <img src={heroSrc(latest.data.date)} alt={latest.data.title} class="w-full aspect-video object-cover" />
      <div class="p-5">
        <div class="text-xs text-indigo-600 font-semibold mb-1">最新記事 · {latest.data.date}</div>
        <h2 class="text-xl font-bold text-slate-900 mb-2">{latest.data.title}</h2>
        <p class="text-sm text-slate-600">{latest.data.description}</p>
      </div>
    </a>
  )}

  {rest.length > 0 && (
    <section>
      <h3 class="text-sm font-semibold text-slate-500 mb-3">最近の記事</h3>
      <ul class="space-y-3">
        {rest.map((post) => (
          <li>
            <a
              href={url(`posts/${post.data.date}/`)}
              class="block rounded-lg border border-slate-200 bg-white p-4 hover:border-indigo-300 no-underline"
            >
              <div class="text-xs text-slate-400 mb-1">{post.data.date}</div>
              <div class="font-semibold text-slate-900">{post.data.title}</div>
              <div class="text-sm text-slate-500 mt-1">{post.data.description}</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mt-8">
    <a href={url('archive/')} class="text-sm text-indigo-600 hover:underline">
      すべてのアーカイブを見る →
    </a>
  </div>
</BaseLayout>
