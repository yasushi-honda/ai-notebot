---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('care');
  return posts.map((post) => ({
    params: { date: post.data.date },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <nav class="text-xs text-ink-soft mb-4">
    <a href={url('')} class="hover:text-verify">ホーム</a> /
    <a href={url('care/')} class="hover:text-care">介護AIハック</a> /
    <span class="tabular-nums font-mono">{post.data.date}</span>
  </nav>

  <div class="care-page">
    <div class="text-xs text-care font-semibold mb-2">
      <span class="font-mono tabular-nums">{post.data.date}</span> · 介護現場のAI活用
    </div>
    <h1 class="font-display text-2xl font-medium text-ink mb-2">{post.data.title}</h1>
    <p class="text-ink-soft mb-6">{post.data.summary}</p>

    <!-- dl/dt/dd（定義リスト）はラベルと値のペア構造を要求するため、"ラベル: 値" を
         1つのテキストにまとめて表示するpillとは意味構造が合わない（codex reviewで指摘・修正）。
         意味的に正しいのは単なるリストなので div に変更する。 -->
    <div class="care-meta">
      <span class="care-meta-pill">対象: {post.data.targetServices.join(' / ')}</span>
      <span class="care-meta-pill">業務領域: {post.data.workArea}</span>
      <span class="care-meta-pill">導入の手間: {post.data.difficulty}</span>
    </div>

    <!--
      手順フロー図はかつて決定的生成SVG画像（steps.svg）として本文と別に表示していたが、
      固定キャンバス幅がコンテナ幅を使い切らず右側に余白ができるバグが過去記事も含め再発し、
      修正のたびにバックフィルが必要になっていた。本文「## 手順」の番号付きリストは
      global.css の .prose-care ol で既にネイティブ描画されており内容が完全に重複していたため、
      画像を廃止しリストを唯一の表示手段にした（幅は常にコンテナ幅に追従するため、この
      バグクラス自体が構造的に発生しなくなる。docs/adr/adr-2026-09-11-deterministic-svg-to-native-html.md）。
    -->

    <article class="prose-care">
      <Content />
    </article>

    <!--
      個人情報の取り扱いに関する注意（固定文言・毎回必ず表示。ユーザーからのフィードバック
      （要配慮個人情報を扱う前提のハックを注意喚起なしに無責任に紹介している）を受けて追加）。

      【AGENTS.mdの「本文の全主張は脚注に紐付く」invariantに対する意図的な例外であることの
      明記（codex reviewで指摘）】: この文言は data/raw-care の出典から脚注で裏付ける対象には
      しない。理由は、(1) LLMが生成する自由記述ではなく人間が直接書いた固定文言であるため
      ハルシネーションのリスクがそもそも存在しない、(2) 日によって出典に個人情報保護関連の
      情報が含まれるとは限らないため、脚注必須にすると「その日はこの注意書きが出ない」という
      事態が起こりうるが、それはユーザーが求める「毎回必ず出す安全装置」という要件に反する、
      (3) 特定の法令名・条文を断定的に引用しない一般的な注意喚起であり、事実主張ではなく
      推奨行動の提示であるため。この例外は「見出し・テーブル等の機械生成構造要素は脚注検証の
      対象外」という既存の設計方針（citation-gate.mjs）と同じカテゴリの拡張であり、
      docs/adr/adr-2026-09-11-care-hack-grounded-research.md に追記済み。
    -->
    <div class="care-privacy-note">
      <strong>個人情報を扱う際の注意:</strong>
      利用者様のお名前や心身の状況など、要配慮個人情報を含む情報をAIツールに入力する場合は、
      氏名等を匿名化・仮名化する、所属先が契約している法人向けプラン（学習利用オフ設定等）を
      利用する等、所属先の情報管理ルールに従ってください。
    </div>

    <p class="verify-label mt-6">
      <span class="verify-dot"></span>
      この記事の出典 {post.data.sourceIds.length} 件はすべて、到達性を機械検証済みの実在するウェブページに解決することを検証済みです。
    </p>

    {post.data.searchEntryPointHtml && (
      <div class="mt-4">
        <Fragment set:html={post.data.searchEntryPointHtml} />
      </div>
    )}
  </div>
</BaseLayout>
