---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));

// 月別グルーピング（YYYY-MM単位）
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const ym = post.data.date.slice(0, 7);
  if (!groups.has(ym)) groups.set(ym, []);
  groups.get(ym)!.push(post);
}
---

<BaseLayout title="アーカイブ" description="日次AIトレンド記事のアーカイブ一覧">
  <h1 class="font-display text-2xl font-medium text-ink mb-8">
    アーカイブ（全{posts.length}件）
  </h1>

  {[...groups.entries()].map(([ym, monthPosts], i) => (
    <details class="archive-month mb-4" open={i === 0}>
      <summary class="font-mono text-[19px] font-semibold text-ink tabular-nums cursor-pointer py-2">
        {ym}（{monthPosts.length}件）
      </summary>
      <ul class="mt-2 mb-6">
        {monthPosts.map((post) => (
          <li>
            <a href={url(`posts/${post.data.date}/`)} class="list-link list-link-compact list-link-inline">
              <span class="list-link-meta font-mono tabular-nums">{post.data.date}</span>
              <span class="list-link-title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}

  {posts.length === 0 && <p class="text-ink-soft">まだ記事がありません。</p>}
</BaseLayout>
