---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));

// 月別グルーピング（YYYY-MM単位）
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const ym = post.data.date.slice(0, 7);
  if (!groups.has(ym)) groups.set(ym, []);
  groups.get(ym)!.push(post);
}
---

<BaseLayout title="アーカイブ" description="日次AIトレンド記事のアーカイブ一覧">
  <h1 class="text-2xl font-bold text-stone-900 mb-8" style="font-family: var(--font-display);">
    アーカイブ（全{posts.length}件）
  </h1>

  {[...groups.entries()].map(([ym, monthPosts]) => (
    <section class="mb-10">
      <h2 class="text-sm font-semibold text-stone-500 mb-1 tabular-nums">{ym}</h2>
      <ul>
        {monthPosts.map((post) => (
          <li>
            <a href={url(`posts/${post.data.date}/`)} class="list-link list-link-compact list-link-inline">
              <span class="text-xs text-stone-400 tabular-nums">{post.data.date}</span>
              <span class="list-link-title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {posts.length === 0 && <p class="text-stone-500">まだ記事がありません。</p>}
</BaseLayout>
