---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { date: post.data.date },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// チャット共有用テキスト（LLM不使用・機械組み立て）。テーマ見出しの箇条書き＋詳細ページへの
// 絶対URLのみで構成し、新たなAI生成テキストは追加しない（既存の検証済みデータの再利用）。
// themeTitles は本機能で新規追加したfrontmatterのため、それ以前に生成済みの記事には
// 存在しない（スキーマのdefault []になる）。その場合は tags にフォールバックし、
// 箇条書きが空にならないようにする（codex reviewで指摘・修正）。
const canonicalUrl = new URL(url(`posts/${post.data.date}/`), Astro.site).href;
const topics = post.data.themeTitles.length > 0 ? post.data.themeTitles : post.data.tags;
const shareText = [
  post.data.title,
  '',
  ...topics.map((t) => `・${t}`),
  '',
  `続きを読む → ${canonicalUrl}`,
].join('\n');
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <nav class="text-xs text-ink-soft mb-4">
    <a href={url('')} class="hover:text-verify">ホーム</a> /
    <a href={url('archive/')} class="hover:text-verify">アーカイブ</a> /
    <span class="tabular-nums font-mono">{post.data.date}</span>
  </nav>

  <h1 class="font-display text-2xl font-medium text-ink mb-2">{post.data.title}</h1>
  <p class="text-ink-soft mb-6">{post.data.description}</p>

  <img
    src={url(`images/${post.data.date}/hero.jpg`)}
    alt={post.data.title}
    class="w-full aspect-video object-cover rounded-lg border border-rule mb-8"
    onerror="this.onerror=null;this.src=this.src.replace('.jpg','.svg')"
  />

  <div class="flex flex-wrap gap-2 mb-8">
    {post.data.tags.map((tag) => (
      <a
        href={url(`tags/${encodeURIComponent(tag)}/`)}
        class="text-xs font-medium px-2.5 py-1 rounded-full bg-verify-soft text-verify no-underline hover:bg-verify hover:text-white transition-colors"
      >
        #{tag}
      </a>
    ))}
  </div>

  <button
    id="copy-share-btn"
    type="button"
    class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 mb-8 rounded-full
      border border-rule text-ink-soft hover:border-verify hover:text-verify transition-colors cursor-pointer
      bg-transparent"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span>シェア用にコピー</span>
  </button>

  <!--
    「今日のトピック一覧」の図解はかつて決定的生成SVG画像（overview.svg）として本文と別に
    表示していたが、固定キャンバス幅がコンテナ幅を使い切らず余白ができるバグが過去記事も
    含め再発していた。本文冒頭のテーマ別ソース内訳テーブル（curate.mjsが機械生成、
    global.cssの .prose-post table で表示）と内容が完全に重複していたため、画像を廃止し
    テーブルを唯一の表示手段にした（docs/adr/adr-2026-09-11-deterministic-svg-to-native-html.md）。
  -->

  <article class="prose-post">
    <Content />
  </article>

  <p class="verify-label mt-10">
    <span class="verify-dot"></span>
    この記事の出典 {post.data.sourceIds.length} 件はすべて、収集日のアーカイブに実在するエントリに解決することを機械検証済みです。
  </p>
</BaseLayout>

<script define:vars={{ shareText }}>
  const btn = document.getElementById('copy-share-btn');
  const label = btn?.querySelector('span');
  if (btn && label) {
    const defaultLabel = label.textContent;
    let resetTimer;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareText);
        label.textContent = 'コピーしました ✓';
      } catch {
        // navigator.clipboard が使えない環境（非HTTPS等）向けの簡易フォールバック
        window.prompt('コピーできませんでした。以下を選択してコピーしてください:', shareText);
      }
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        label.textContent = defaultLabel;
      }, 2000);
    });
  }
</script>
