---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { date: post.data.date },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// チャット共有用テキスト（LLM不使用・機械組み立て）。テーマ見出しの箇条書き＋詳細ページへの
// 絶対URLのみで構成し、新たなAI生成テキストは追加しない（既存の検証済みデータの再利用）。
// themeTitles は本機能で新規追加したfrontmatterのため、それ以前に生成済みの記事には
// 存在しない（スキーマのdefault []になる）。その場合は tags にフォールバックし、
// 箇条書きが空にならないようにする（codex reviewで指摘・修正）。
const canonicalUrl = new URL(url(`posts/${post.data.date}/`), Astro.site).href;
const topics = post.data.themeTitles.length > 0 ? post.data.themeTitles : post.data.tags;
const shareText = [
  `🤖 ${post.data.title}`,
  '',
  ...topics.map((t) => `・${t}`),
  '',
  `続きを読む → ${canonicalUrl}`,
].join('\n');
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <nav class="text-sm text-slate-400 mb-4">
    <a href={url('')} class="hover:text-indigo-600">ホーム</a> /
    <a href={url('archive/')} class="hover:text-indigo-600">アーカイブ</a> /
    {post.data.date}
  </nav>

  <h1 class="text-2xl font-bold text-slate-900 mb-2">{post.data.title}</h1>
  <p class="text-slate-500 mb-6">{post.data.description}</p>

  <img
    src={url(`images/${post.data.date}/hero.jpg`)}
    alt={post.data.title}
    class="w-full aspect-video object-cover rounded-xl mb-8"
    onerror="this.onerror=null;this.src=this.src.replace('.jpg','.svg')"
  />

  <div class="flex flex-wrap gap-2 mb-8">
    {post.data.tags.map((tag) => (
      <a
        href={url(`tags/${encodeURIComponent(tag)}/`)}
        class="text-xs px-2 py-1 rounded-full bg-indigo-50 text-indigo-700 no-underline hover:bg-indigo-100"
      >
        #{tag}
      </a>
    ))}
  </div>

  <button
    id="copy-share-btn"
    type="button"
    class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 mb-8 rounded-full
      bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-colors cursor-pointer
      border-0"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span>シェア用にコピー</span>
  </button>

  <img
    src={url(`images/${post.data.date}/overview.svg`)}
    alt="今日のトピック一覧"
    class="overview-diagram"
    onerror="this.style.display='none'"
  />

  <article class="prose-post">
    <Content />
  </article>

  <section class="mt-10 grid grid-cols-2 gap-4">
    {[1, 2].map((n) => (
      <img
        src={url(`images/${post.data.date}/section-${n}.jpg`)}
        alt={`${post.data.title} 関連画像${n}`}
        class="w-full aspect-4/3 object-cover rounded-lg"
        onerror="this.onerror=null;this.src=this.src.replace('.jpg','.svg')"
      />
    ))}
  </section>

  <p class="mt-10 text-xs text-slate-400">
    この記事の出典 {post.data.sourceIds.length} 件はすべて、収集日のアーカイブに実在するエントリに解決することを機械検証済みです。
  </p>
</BaseLayout>

<script define:vars={{ shareText }}>
  const btn = document.getElementById('copy-share-btn');
  const label = btn?.querySelector('span');
  if (btn && label) {
    const defaultLabel = label.textContent;
    let resetTimer;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareText);
        label.textContent = 'コピーしました ✓';
      } catch {
        // navigator.clipboard が使えない環境（非HTTPS等）向けの簡易フォールバック
        window.prompt('コピーできませんでした。以下を選択してコピーしてください:', shareText);
      }
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        label.textContent = defaultLabel;
      }, 2000);
    });
  }
</script>
